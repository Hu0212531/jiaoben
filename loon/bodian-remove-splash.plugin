#!name=波点音乐去开屏广告
#!desc=重写开屏弹窗接口返回，告诉App无弹窗可显示。独立插件，不影响VIP解锁插件
#!author=Rocky

[Rewrite]
^https?://bd-api\.kuwo\.cn/api/popup/start/info.*$ http-response script-path=https://cdn.jsdelivr.net/gh/Hu0212531/jiaoben@/loon/bodian-no-popup.js, requires-body=true, tag=波点去开屏弹窗

[Mitm]
hostname = bd-api.kuwo.cn
