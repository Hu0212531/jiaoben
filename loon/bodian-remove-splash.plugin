#!name=波点音乐去开屏广告
#!desc=拦截开屏广告及广告配置接口。独立插件，不修改、不影响波点音乐VIP解锁插件
#!author=Rocky

# 原理：开屏广告展示前 App 会先请求广告配置接口，
# 直接 reject 这些请求，App 取不到广告配置就会跳过开屏。
# 规则只针对广告接口，播放、VIP 校验等接口不受影响。

[Rewrite]
^https?://bd-api\.kuwo\.cn/api/popup/start/info.*$ reject
^https?://bd-api\.kuwo\.cn/api/service/advert/config.*$ reject
^https?://mc\.tencentmusic\.com/sdk/ad/.*$ reject

[Mitm]
hostname = bd-api.kuwo.cn, mc.tencentmusic.com
