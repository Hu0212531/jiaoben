#!name=波点音乐去开屏广告
#!desc=重写开屏弹窗接口返回，告诉App无弹窗可显示。独立插件，不影响VIP解锁插件
#!author=Rocky

# v3 换思路：不再 reject 请求，而是改写 /api/popup/start/info 的返回，
# 把 content.show 置为 false，App 走正常"无广告"分支直接进主界面。

[Rewrite]
^https?://bd-api\.kuwo\.cn/api/popup/start/info.*$ http-response script-path=https://cdn.jsdelivr.net/gh/Hu0212531/jiaoben@61a8bd8d2f1b5cfdcd16cf0f03a66943165e2030/loon/bodian-no-popup.js, requires-body=true, tag=波点去开屏弹窗

[Mitm]
hostname = bd-api.kuwo.cn
